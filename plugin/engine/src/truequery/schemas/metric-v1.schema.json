{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Analytically-ai/truequery/main/plugin/engine/src/truequery/schemas/metric-v1.schema.json",
  "title": "TrueQuery Governed Metric v1",
  "description": "TrueQuery version 1 governed metric definition schema (metrics/*.yaml).",
  "type": "object",
  "additionalProperties": false,
  "required": ["metric", "kind", "dataset"],
  "properties": {
    "version": {
      "const": 1,
      "default": 1
    },
    "metric": {
      "$ref": "#/$defs/identifier",
      "description": "Unique metric identifier."
    },
    "meaning": {
      "type": ["string", "null"],
      "description": "Plain-English meaning of the metric."
    },
    "kind": {
      "type": "string",
      "enum": ["simple", "ratio"],
      "description": "Metric structure: 'simple' (uses measure) or 'ratio' (uses numerator and denominator)."
    },
    "dataset": {
      "$ref": "#/$defs/dottedIdentifier",
      "description": "Dataset name matching a contract in contracts/."
    },
    "numerator": {
      "$ref": "#/$defs/measureBlock"
    },
    "denominator": {
      "$ref": "#/$defs/measureBlock"
    },
    "measure": {
      "$ref": "#/$defs/measureBlock"
    },
    "grain": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "\\S"},
        {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/identifier"}
        }
      ]
    },
    "unit": {
      "type": ["string", "null"],
      "enum": [
        "bytes", "KB", "KiB", "MB", "MiB", "GB", "GiB", "TB", "TiB",
        "ms", "s", "min", "h", "d",
        "ratio", "percent", "bps",
        "minor", "major",
        null
      ]
    },
    "owner": {
      "type": ["string", "null"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"kind": {"const": "ratio"}},
        "required": ["kind"]
      },
      "then": {
        "required": ["numerator", "denominator"],
        "not": {"required": ["measure"]}
      }
    },
    {
      "if": {
        "properties": {"kind": {"const": "simple"}},
        "required": ["kind"]
      },
      "then": {
        "required": ["measure"],
        "not": {
          "anyOf": [
            {"required": ["numerator"]},
            {"required": ["denominator"]}
          ]
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_$\\u00aa\\u00b5\\u00ba\\u00c0-\\u00d6\\u00d8-\\u00f6\\u00f8-\\u02c1\\u0370-\\u037d\\u037f-\\u167f\\u1681-\\u1fff\\u2c00-\\u2fef\\u3040-\\ud7ff\\uf900-\\ufdcf\\ufdf0-\\ufefe\\uff10-\\uff19\\uff21-\\uff3a\\uff41-\\uff5a\\uff66-\\uffdc-](?:[A-Za-z0-9_ $\\u0300-\\u036f\\u00aa\\u00b5\\u00ba\\u00c0-\\u00d6\\u00d8-\\u00f6\\u00f8-\\u02c1\\u0370-\\u037d\\u037f-\\u167f\\u1681-\\u1fff\\u2c00-\\u2fef\\u3040-\\ud7ff\\uf900-\\ufdcf\\ufdf0-\\ufefe\\uff10-\\uff19\\uff21-\\uff3a\\uff41-\\uff5a\\uff66-\\uffdc-]*[A-Za-z0-9_$\\u0300-\\u036f\\u00aa\\u00b5\\u00ba\\u00c0-\\u00d6\\u00d8-\\u00f6\\u00f8-\\u02c1\\u0370-\\u037d\\u037f-\\u167f\\u1681-\\u1fff\\u2c00-\\u2fef\\u3040-\\ud7ff\\uf900-\\ufdcf\\ufdf0-\\ufefe\\uff10-\\uff19\\uff21-\\uff3a\\uff41-\\uff5a\\uff66-\\uffdc-])?(?!\\n)$"
    },
    "dottedIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_$\\u00aa\\u00b5\\u00ba\\u00c0-\\u00d6\\u00d8-\\u00f6\\u00f8-\\u02c1\\u0370-\\u037d\\u037f-\\u167f\\u1681-\\u1fff\\u2c00-\\u2fef\\u3040-\\ud7ff\\uf900-\\ufdcf\\ufdf0-\\ufefe\\uff10-\\uff19\\uff21-\\uff3a\\uff41-\\uff5a\\uff66-\\uffdc-](?:[A-Za-z0-9_ $\\u0300-\\u036f\\u00aa\\u00b5\\u00ba\\u00c0-\\u00d6\\u00d8-\\u00f6\\u00f8-\\u02c1\\u0370-\\u037d\\u037f-\\u167f\\u1681-\\u1fff\\u2c00-\\u2fef\\u3040-\\ud7ff\\uf900-\\ufdcf\\ufdf0-\\ufefe\\uff10-\\uff19\\uff21-\\uff3a\\uff41-\\uff5a\\uff66-\\uffdc-]*[A-Za-z0-9_$\\u0300-\\u036f\\u00aa\\u00b5\\u00ba\\u00c0-\\u00d6\\u00d8-\\u00f6\\u00f8-\\u02c1\\u0370-\\u037d\\u037f-\\u167f\\u1681-\\u1fff\\u2c00-\\u2fef\\u3040-\\ud7ff\\uf900-\\ufdcf\\ufdf0-\\ufefe\\uff10-\\uff19\\uff21-\\uff3a\\uff41-\\uff5a\\uff66-\\uffdc-])?(?:\\.[A-Za-z0-9_$\\u00aa\\u00b5\\u00ba\\u00c0-\\u00d6\\u00d8-\\u00f6\\u00f8-\\u02c1\\u0370-\\u037d\\u037f-\\u167f\\u1681-\\u1fff\\u2c00-\\u2fef\\u3040-\\ud7ff\\uf900-\\ufdcf\\ufdf0-\\ufefe\\uff10-\\uff19\\uff21-\\uff3a\\uff41-\\uff5a\\uff66-\\uffdc-](?:[A-Za-z0-9_ $\\u0300-\\u036f\\u00aa\\u00b5\\u00ba\\u00c0-\\u00d6\\u00d8-\\u00f6\\u00f8-\\u02c1\\u0370-\\u037d\\u037f-\\u167f\\u1681-\\u1fff\\u2c00-\\u2fef\\u3040-\\ud7ff\\uf900-\\ufdcf\\ufdf0-\\ufefe\\uff10-\\uff19\\uff21-\\uff3a\\uff41-\\uff5a\\uff66-\\uffdc-]*[A-Za-z0-9_$\\u0300-\\u036f\\u00aa\\u00b5\\u00ba\\u00c0-\\u00d6\\u00d8-\\u00f6\\u00f8-\\u02c1\\u0370-\\u037d\\u037f-\\u167f\\u1681-\\u1fff\\u2c00-\\u2fef\\u3040-\\ud7ff\\uf900-\\ufdcf\\ufdf0-\\ufefe\\uff10-\\uff19\\uff21-\\uff3a\\uff41-\\uff5a\\uff66-\\uffdc-])?)*(?!\\n)$"
    },
    "measureBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agg", "column"],
      "properties": {
        "agg": {
          "type": "string",
          "enum": ["count", "count_distinct", "sum", "avg", "min", "max"]
        },
        "column": {
          "oneOf": [
            {"const": "*"},
            {"$ref": "#/$defs/identifier"}
          ]
        },
        "where": {
          "type": ["string", "null"],
          "pattern": "\\S"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"agg": {"not": {"const": "count"}}},
            "required": ["agg"]
          },
          "then": {
            "properties": {"column": {"$ref": "#/$defs/identifier"}}
          }
        }
      ]
    }
  }
}

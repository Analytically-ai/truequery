{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://truequery.ai/schemas/contract-v2.schema.json",
  "title": "TrueQuery Dataset Contract v2",
  "description": "TrueQuery version 2 dataset contract schema for tables and file collections.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "grain", "keys"],
  "anyOf": [
    {"required": ["dataset"]},
    {"required": ["table"]}
  ],
  "properties": {
    "version": {
      "const": 2,
      "description": "Contract schema version (must be 2)."
    },
    "dataset": {
      "type": "string",
      "minLength": 1,
      "description": "Dataset or relation name."
    },
    "table": {
      "type": "string",
      "minLength": 1,
      "description": "Alias for dataset (preserved for v1 compatibility)."
    },
    "meaning": {
      "type": ["string", "null"],
      "description": "Plain-English description of what the dataset represents."
    },
    "kind": {
      "type": "string",
      "enum": ["table", "files"],
      "default": "table",
      "description": "Dataset storage kind: warehouse/local DB table or file collection."
    },
    "status": {
      "type": "string",
      "enum": ["confirmed", "draft"],
      "default": "confirmed",
      "description": "Whether the contract is confirmed by the team or an inferred draft."
    },
    "inferred_from": {
      "type": ["string", "null"],
      "minLength": 1,
      "description": "Required when status is 'draft'; describes the sample or source."
    },
    "location": {
      "type": ["object", "null"]
    },
    "grain": {
      "type": "string",
      "minLength": 1,
      "description": "Plain-English grain declaration (e.g. 'one row per fetch attempt')."
    },
    "keys": {
      "type": "array",
      "description": "Candidate keys: string elements are single-column keys; nested string arrays are composite keys.",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        ]
      }
    },
    "partition_key": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1},
        {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      ]
    },
    "freshness_sla": {
      "oneOf": [
        {"type": "null"},
        {"type": "string"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["column", "max_age"],
          "properties": {
            "column": {"type": "string", "minLength": 1},
            "max_age": {
              "type": "string",
              "pattern": "^[1-9]\\d*(?:ms|s|m|h|d)$"
            }
          }
        }
      ]
    },
    "deprecated": {
      "type": "boolean",
      "default": false
    },
    "quirks": {
      "type": ["string", "null"]
    },
    "write_mode": {
      "type": ["string", "null"],
      "enum": ["append", "overwrite_partition", "merge_on_key", null]
    },
    "columns": {
      "type": ["object", "null"],
      "additionalProperties": {
        "$ref": "#/$defs/columnSpec"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "draft"}},
        "required": ["status"]
      },
      "then": {
        "required": ["inferred_from"],
        "properties": {
          "inferred_from": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "if": {
        "not": {
          "properties": {"status": {"const": "draft"}},
          "required": ["status"]
        }
      },
      "then": {
        "properties": {
          "columns": {
            "type": ["object", "null"],
            "additionalProperties": {
              "$ref": "#/$defs/confirmedColumnValues"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"kind": {"const": "files"}},
        "required": ["kind"]
      },
      "then": {
        "required": ["location"],
        "properties": {
          "location": {"$ref": "#/$defs/filesLocation"}
        }
      }
    },
    {
      "if": {
        "not": {
          "properties": {"kind": {"const": "files"}},
          "required": ["kind"]
        }
      },
      "then": {
        "properties": {
          "location": {"$ref": "#/$defs/tableLocation"}
        }
      }
    }
  ],
  "$defs": {
    "filesLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "format"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "base": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "format": {
          "type": "string",
          "enum": ["csv", "jsonl", "json", "parquet"]
        }
      }
    },
    "tableLocation": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "database": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "relation": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "base": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    },
    "unitEnum": {
      "type": "string",
      "enum": [
        "bytes", "KB", "KiB", "MB", "MiB", "GB", "GiB", "TB", "TiB",
        "ms", "s", "min", "h", "d",
        "ratio", "percent", "bps",
        "minor", "major"
      ]
    },
    "confirmedColumnValues": {
      "type": "object",
      "properties": {
        "values": {
          "oneOf": [
            {"type": "null"},
            {"type": "array"},
            {
              "type": "object",
              "additionalProperties": {
                "type": ["object", "null"],
                "properties": {
                  "means": {
                    "type": ["string", "null"],
                    "enum": ["present", "absent_expected", "absent_unexpected", null]
                  }
                }
              }
            }
          ]
        }
      }
    },
    "columnSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": ["string", "null"],
          "enum": ["string", "integer", "number", "boolean", "date", "timestamp", "path", null]
        },
        "nullable": {
          "type": ["boolean", "null"]
        },
        "meaning": {
          "type": ["string", "null"]
        },
        "description": {
          "type": ["string", "null"]
        },
        "unit": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/unitEnum"}
          ]
        },
        "currency": {
          "type": ["string", "null"],
          "pattern": "^[A-Z]{3}$"
        },
        "currency_column": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "size_of": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "time_zone": {
          "type": ["string", "null"],
          "pattern": "^(?:UTC|naive|local:[A-Za-z0-9_+-]+(?:/[A-Za-z0-9_+-]+)+)$"
        },
        "relative_to": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "status_column": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "values": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "array",
              "minItems": 1,
              "items": {"type": ["string", "integer", "number"]}
            },
            {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": ["object", "null"],
                "additionalProperties": false,
                "properties": {
                  "means": {
                    "type": ["string", "null"],
                    "enum": ["present", "absent_expected", "absent_unexpected", "TODO", null]
                  },
                  "meaning": {
                    "type": ["string", "null"]
                  }
                }
              }
            }
          ]
        },
        "pii": {
          "type": ["boolean", "null"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"unit": {"enum": ["minor", "major"]}},
            "required": ["unit"]
          },
          "then": {
            "anyOf": [
              {
                "required": ["currency"],
                "properties": {"currency": {"type": "string"}}
              },
              {
                "required": ["currency_column"],
                "properties": {"currency_column": {"type": "string"}}
              }
            ]
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "required": ["currency"],
                "properties": {"currency": {"type": "string"}}
              },
              {
                "required": ["currency_column"],
                "properties": {"currency_column": {"type": "string"}}
              }
            ]
          },
          "then": {
            "required": ["unit"],
            "properties": {"unit": {"enum": ["minor", "major"]}}
          }
        },
        {
          "not": {
            "required": ["currency", "currency_column"],
            "properties": {
              "currency": {"type": "string"},
              "currency_column": {"type": "string"}
            }
          }
        },
        {
          "if": {
            "required": ["relative_to"],
            "properties": {"relative_to": {"type": "string"}}
          },
          "then": {
            "required": ["type"],
            "properties": {"type": {"const": "path"}}
          }
        }
      ]
    }
  }
}
